# The build environment. ./build.sh builds this image and runs
# scripts/build.sh in it. Base: Debian trixie, pinned by the digest of its
# multi-arch index. install.sh adds the toolchain from a fixed snapshot.
FROM docker.io/library/debian:trixie-20260918@sha256:9cc080028c43b27d2074d63a5f9caf7166d731494965616c1a6d2827a004585c
COPY install.sh packages-*.lock /tmp/build-env/
# docker build (BuildKit) creates neither /.dockerenv nor /run/.containerenv
# for its build steps; this is a container all the same.
RUN A7S_IN_CONTAINER=1 sh /tmp/build-env/install.sh && rm -rf /tmp/build-env
